<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Content Include="../../updates/test-vectors.json" Link="UpdateVectors.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <!-- The Mac app's live text fixtures, linked so both apps test the very same files. -->
    <Content Include="../../fixtures/live-text/**/*.json" Link="live-text/%(RecursiveDir)%(Filename)%(Extension)"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="../fixtures/settings/settings-before-live-text.json" Link="settings-before-live-text.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>
  <ItemGroup><ProjectReference Include="../PFlow.Core/PFlow.Core.csproj"/></ItemGroup>
</Project>
