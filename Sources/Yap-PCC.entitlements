<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime, non-sandboxed. Microphone access needs an explicit
	     entitlement once the Hardened Runtime is on, which notarization requires. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Only for an Apple-approved, provisioned PCC build. -->
	<key>com.apple.developer.private-cloud-compute</key>
	<true/>
</dict>
</plist>
